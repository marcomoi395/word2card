{
    "name": "word2card",
    "version": "2.3.0",
    "productName": "Word2Card",
    "description": "Electron desktop app for generating Anki flashcards from text files or Notion.",
    "author": "youngmarco",
    "homepage": "https://github.com/marcomoi395/word2card",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/marcomoi395/word2card.git"
    },
    "main": "./out/main/index.js",
    "packageManager": "bun@1.3.14",
    "scripts": {
        "format": "prettier --write .",
        "lint": "eslint --cache .",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
        "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
        "typecheck": "bun run typecheck:node && bun run typecheck:web",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "bun run build && playwright test",
        "test:e2e:local": "bun run build && playwright test",
        "test:e2e:ui": "bun run build && playwright test --ui",
        "test:e2e:debug": "bun run build && playwright test --debug",
        "test:e2e:clean": "rm -rf playwright-report test-results",
        "start": "electron-vite preview",
        "dev": "electron-vite dev",
        "prepare": "git config core.hooksPath .githooks",
        "build": "bun run typecheck && electron-vite build",
        "postinstall": "electron-builder install-app-deps",
        "build:unpack": "bun run build && electron-builder --dir",
        "build:win": "bun run build && electron-builder --win",
        "build:mac": "bun run build && electron-builder --mac",
        "build:linux": "bun run build && electron-builder --linux"
    },
    "dependencies": {
        "@electron-toolkit/preload": "^3.0.2",
        "@electron-toolkit/utils": "^4.0.0",
        "@notionhq/client": "^5.7.0",
        "dotenv": "^17.2.3",
        "electron-store": "^6.0.1",
        "microsoft-cognitiveservices-speech-sdk": "^1.47.0",
        "openai": "^6.16.0",
        "p-limit": "^3.1.0",
        "pexels": "^1.4.0",
        "uuid": "^13.0.2",
        "vite-plugin-static-copy": "^3.1.4"
    },
    "devDependencies": {
        "@electron-toolkit/eslint-config-prettier": "^3.0.0",
        "@electron-toolkit/eslint-config-ts": "^3.1.0",
        "@electron-toolkit/tsconfig": "^2.0.0",
        "@playwright/test": "^1.61.1",
        "@types/node": "^22.19.7",
        "@types/uuid": "^10.0.0",
        "@vitest/coverage-v8": "^4.1.10",
        "electron": "^43.4.1",
        "electron-builder": "^26.0.12",
        "electron-vite": "^5.0.0",
        "eslint": "^9.39.5",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-unused-imports": "^4.3.0",
        "jsdom": "^30.0.1",
        "playwright": "^1.61.1",
        "prettier": "^3.7.4",
        "typescript": "^5.9.3",
        "vite": "^7.2.6",
        "vitest": "^4.1.10"
    },
    "overrides": {
        "brace-expansion": "1.1.18"
    },
    "trustedDependencies": [
        "electron",
        "electron-winstaller",
        "esbuild"
    ]
}
